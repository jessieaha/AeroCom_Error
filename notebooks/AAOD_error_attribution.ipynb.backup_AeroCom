        "        sub = sub[(sub['time'] >= t0) & (sub['time'] <= t1)]\n",
        "        if sub.empty:\n",
        "            print(f'  {region}: no POLDER samples')\n",
        "            details[region] = {'skipped': True}\n",
        "            continue\n",
        "        obs_sampled = float(np.average(sub[obs_col], weights=np.cos(np.deg2rad(sub['latitude']))))\n",
