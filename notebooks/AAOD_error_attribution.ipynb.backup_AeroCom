        "        return float(tau), 'box_budget'\n",
        "    return None, None\n",
        "\n",
        "\n",
        "def _es_tau_mac_terms(e_kg_m2_s, tau_days, mac):\n",
        "    \"\"\"Build Nature Eq. 6 predictors with AAOD unit convention.\n",
        "\n",
        "    E [kg m^-2 s^-1] -> g m^-2 day^-1; then\n",
